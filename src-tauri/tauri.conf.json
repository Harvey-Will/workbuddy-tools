{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkBuddy Tools",
  "version": "0.1.2",
  "identifier": "com.workbuddy.tools",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run ui:build && node scripts/copy-ui-dist.mjs",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "WorkBuddy Tools",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:18765 http://localhost:18765 http://127.0.0.1:* http://localhost:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  },
  "plugins": {}
}

